# Read by Cloudflare Pages (and Netlify): the sideloadable Android app is served as an installer; the service worker is always revalidated.
/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename=TracksidePass.apk
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
